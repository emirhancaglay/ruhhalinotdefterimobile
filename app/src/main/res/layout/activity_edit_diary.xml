<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            style="@style/ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Günlük Düzenle"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView
                style="@style/FormLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Başlık"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/editTitleEditText"
                style="@style/FormInput"
                android:hint="Başlık yazınız"
                android:inputType="text"
                android:layout_marginBottom="18dp" />

            <TextView
                style="@style/FormLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/editNoteEditText"
                style="@style/FormInput"
                android:layout_height="150dp"
                android:gravity="top|start"
                android:hint="Notunuzu yazınız"
                android:inputType="textMultiLine"
                android:layout_marginBottom="18dp" />

            <TextView
                style="@style/FormLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ruh Hali"
                android:layout_marginBottom="7dp" />

            <Spinner
                android:id="@+id/editMoodSpinner"
                style="@style/FormInput"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/editTemperatureText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_weather_card"
                android:padding="14dp"
                android:text="Sıcaklık: Bilinmiyor"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/updateButton"
                style="@style/PrimaryButton"
                android:text="Güncelle" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
